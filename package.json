{
  "name": "el-changuito",
  "version": "2.0.0",
  "description": "PWA para comparar precios y gestionar carrito de compras",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 4200",
    "build": "next build",
    "start": "next start -p 4200",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "sepa:etl": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sepa/etl.ts",
    "postinstall": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/copy-zxing-wasm.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "barcode-detector": "^3.2.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
